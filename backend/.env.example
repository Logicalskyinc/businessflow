# BusinessFlow backend environment
PORT=3000
NODE_ENV=development

# Existing GrowthFlow Supabase project URL.
SUPABASE_URL=https://xsembvcmcodcseqnpyrr.supabase.co

# Use the project's publishable/anon key on the server for user-scoped requests.
# Do NOT put a service-role key here and never expose one in the frontend.
SUPABASE_ANON_KEY=

# Grey service integration. Server-side only; use the same secret configured in Grey.
GREY_API_URL=https://grey-ai-service.onrender.com
GREY_BUSINESSFLOW_JWT_SECRET=

# Stripe sandbox credentials. Never use live keys before production approval.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Fixed trusted return URLs. Client-supplied redirect URLs are not accepted.
BILLING_CHECKOUT_SUCCESS_URL=https://logicalskyinc.github.io/businessflow/#billing-success
BILLING_CHECKOUT_CANCEL_URL=https://logicalskyinc.github.io/businessflow/#billing
BILLING_PORTAL_RETURN_URL=https://logicalskyinc.github.io/businessflow/#billing

# Server-only key. Never expose this value in frontend code.
SUPABASE_SERVICE_ROLE_KEY=
