# BusinessFlow backend environment
PORT=3000
NODE_ENV=development

# Existing GrowthFlow Supabase project URL.
SUPABASE_URL=https://xsembvcmcodcseqnpyrr.supabase.co

# Use the project's publishable/anon key on the server for user-scoped requests.
# Do NOT put a service-role key here and never expose one in the frontend.
SUPABASE_ANON_KEY=

# Optional server-to-server OYOSKY reasoning. Keep the token server-side.
OYOSKY_SERVICE_URL=https://oyosky.onrender.com
OYOSKY_BUSINESSFLOW_SERVICE_TOKEN=

# Server-to-server Grey chat. Use the actual owner service, never the preview.
# The shared HS256 secret must match the secret configured on Grey and be at least 32 characters.
GREY_SERVICE_URL=https://grey-ai-service.onrender.com
GREY_BUSINESSFLOW_JWT_SECRET=
