# BusinessFlow backend environment
PORT=3000
NODE_ENV=development

# Existing GrowthFlow Supabase project URL.
SUPABASE_URL=https://xsembvcmcodcseqnpyrr.supabase.co

# Use the project's publishable/anon key on the server for user-scoped requests.
# Do NOT put a service-role key here and never expose one in the frontend.
SUPABASE_ANON_KEY=

# Grey server-to-server integration.
# Set these only in the BusinessFlow backend environment, never in browser code.
GREY_API_URL=https://your-grey-service.onrender.com
GREY_BUSINESSFLOW_JWT_SECRET=
